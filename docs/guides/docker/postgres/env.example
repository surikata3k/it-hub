# Copy this file as .env (next to compose.yaml) and edit it.

# ---- Credentials ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=postgres

# ---- Container ----
PG_VERSION=18
PG_CONTAINER=pg18
PG_PORT=5432

# ---- Where the data is stored ----
# Docker volume (recommended on Windows):
PG_DATA=pgdata
# Host folder (see the warning in the guide):
#PG_DATA=./data

# ---- Where the configuration is stored ----
# Host folder (edit it with VS Code / Notepad):
PG_CONF=./conf
# Docker volume:
#PG_CONF=pgconf
